# =============================================
# AgriSmart AI — Environment Variables Template
# Copy this file to .env and fill in your keys
# =============================================

# Google Gemini API Key (free tier at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API base URL (Open-Meteo — no key required)
WEATHER_API_BASE=https://api.open-meteo.com/v1

# Path to ML model weights (relative to backend/ directory)
MODEL_WEIGHTS_PATH=model_weights/disease_model.pt

# Set to "mock" to use stub model (no weights needed), "real" to load actual model
MODEL_MODE=mock

# Server settings
HOST=0.0.0.0
PORT=8000
