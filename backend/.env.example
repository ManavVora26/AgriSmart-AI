# =============================================
# AgriSmart AI — Environment Variables Template
# Copy this file to .env and fill in your keys
# =============================================

# Google Gemini API Key (optional for AI Chat Assistant, free at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyDbxP9sxzIAzoNRopHJLjleoMaO7ZSr8fY

# Weather API base URL (Open-Meteo — free, no API key required)
WEATHER_API_BASE=https://api.open-meteo.com/v1

# Path to ML model weights (relative to backend/ directory)
# The pre-trained weights file is already included at model/best_agri_model.pth
MODEL_WEIGHTS_PATH=../model/best_agri_model.pth

# Set to "real" to load the trained EfficientNet-B0 weights, or "mock" for lightweight testing
MODEL_MODE=real

# Server settings
HOST=0.0.0.0
PORT=8000

